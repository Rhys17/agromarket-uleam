rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuarios: cada quien lee su propio perfil, admin lee todos
    match /usuarios/{uid} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.rol == "cliente";
      allow update: if request.auth != null && request.auth.uid == uid;
    }

    // Productos: todos los autenticados leen, solo admin escribe
    match /productos/{doc} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // Pedidos: el cliente ve los suyos, todos los autenticados crean
    match /pedidos/{doc} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
  }
}
